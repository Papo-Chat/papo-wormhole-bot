# ── Papo ────────────────────────────────────────────────────
PAPO_BASE_URL=https://api.papo.chat
# opcional: derivado de PAPO_BASE_URL (https→wss, + /ws)
# PAPO_WS_URL=wss://api.papo.chat/ws
PAPO_USERNAME=usuario-do-bot
PAPO_PASSWORD=senha-do-bot
# JWT do Papo expira em 24h; renovar antes disso (1–23)
PAPO_REFRESH_HOURS=12
# ao subir, reprocessa mensagens do Papo que não chegaram ao Discord
PAPO_BACKFILL_ON_START=true
# teto de chamadas ao Papo. O backend limita por IP (RATE_LIMIT=10/s, rajada 20)
# todas as rotas, inclusive o handshake do WS — ficar abaixo evita 429.
PAPO_RATE_LIMIT_RPS=8
PAPO_RATE_BURST=12

# ── Discord ─────────────────────────────────────────────────
DISCORD_TOKEN=token-do-bot
# opcional: registra os slash commands em um servidor específico (recomendado)
DISCORD_GUILD_ID=
# limite de upload assumido no Discord: 20971520 = 20 MB (conta free)
DISCORD_MAX_FILE_BYTES=20971520
DISCORD_MAX_MESSAGES_PER_5S=4

# ── Bridge ──────────────────────────────────────────────────
WORMHOLE_DATA_DIR=./data
# WORMHOLE_DB_PATH=./data/wormhole.sqlite

# URL pública HTTPS do media server (necessária para o avatar do autor aparecer no Discord).
# Sem ela os embeds do Discord saem sem author.icon_url.
# WORMHOLE_MEDIA_BASE_URL=https://wormhole.example.com
WORMHOLE_MEDIA_PORT=8787

# canal onde o bot pode publicar avisos (opcional)
# WORMHOLE_ADMIN_CHANNEL_ID=

WORMHOLE_TIMEZONE=America/Sao_Paulo
# importar emojis do Discord para o Papo automaticamente (exige manage_server no Papo)
WORMHOLE_EMOJI_AUTO_IMPORT=true
# propagar menções reais (pode pingar pessoas nos dois lados)
WORMHOLE_PROPAGATE_MENTIONS=false

# retry da fila de saída
WORMHOLE_MAX_ATTEMPTS=12
WORMHOLE_BACKOFF_BASE_MS=1000
WORMHOLE_BACKOFF_MAX_MS=900000

WORMHOLE_LOG_LEVEL=info
